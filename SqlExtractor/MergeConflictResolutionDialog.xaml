<Window x:Class="SqlExtractor.MergeConflictResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SqlExtractor"
        mc:Ignorable="d"
        Title="Merge Conflict" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Merge Conflict!" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            <TextBlock Text="{Binding WarningText}" 
                       TextWrapping="Wrap" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding OldVersionText}" Foreground="Red" Margin="5"/>
                <TextBlock Grid.Column="1" Text="{Binding NewVersionText}" Foreground="Red" Margin="5"/>
            </Grid>
            <Button Content="Preserve Old" Margin="0,5,210,5" Padding="10,5" Width="150"/>
            <Button Content="Use New" Margin="0,5,210,20" Padding="10,5" Width="150"/>
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Rename Old" Grid.Column="0" Padding="10,5" Width="150"/>
                <TextBox Grid.Column="1" Margin="10,0,0,0" Width="200" Text="{Binding NewOldName}"/>
            </Grid>
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Rename New" Grid.Column="0" Padding="10,5" Width="150"/>
                <TextBox Grid.Column="1" Margin="10,0,0,0" Width="200" Text="{Binding NewNewName}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
