<Window x:Class="SqlExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SqlExtractor"
        xmlns:lib="clr-namespace:SqlExtractor.Lib"
        xmlns:treeItem="clr-namespace:SqlExtractor.Lib.TreeItem"
        mc:Ignorable="d"
        Title="SQL Extractor" Height="450" Width="700"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Grid.ColumnSpan="6">
            <MenuItem Header="File">
                <MenuItem Header="Load" Click="Load_OnClick" />
                <MenuItem Header="Save" Click="Save_OnClick" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Manual" Click="Manual_OnClick" />
                <MenuItem Header="GitHub" Click="GitHub_OnClick" />
            </MenuItem>
        </Menu>
        
        <TreeView Grid.Row="1" Grid.Column="1" x:Name="InputTreeView" Margin="30">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type treeItem:AbstractSqlTreeItem}" ItemsSource="{Binding Path=Children}">
                    <TextBlock Text="{Binding Path=Name}" MouseLeftButtonDown="SourceItemClicked" Tag="{Binding}" />
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="+" Margin="0,0,5,0" Width="30" Height="30" Click="AddConnectionButton_Click" />
            <Button Content="-" Margin="0,0,5,0" Width="30" Height="30" Click="RemoveConnectionButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
            <Button Name="AddButton" Margin="10" Width="100" Height="50" Click="AddButton_Click" />
            <Button Name="RemoveButton" Margin="10" Width="100" Height="50" Click="RemoveButton_Click" />
            <CheckBox Name="AddDependenciesCheckbox" Margin="10">Add Dependencies</CheckBox>
            <CheckBox Name="TransferDataCheckBox" Margin="10" IsEnabled="False" Click="TransferDataCheckBox_OnClick">Transfer With Data</CheckBox>
            <Button Margin="5" Name="GenerateScriptButton" Click="GenerateScriptButton_OnClick">Transfer</Button>
            <Button Margin="5" Name="OutputToFolderButton" Click="OutputToFolderButton_OnClick">Save to Folder</Button>
        </StackPanel>

        <TreeView Grid.Row="1" Grid.Column="3" x:Name="OutputTreeView" Margin="30">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type treeItem:AbstractSqlTreeItem}" ItemsSource="{Binding Path=Children}">
                    <!-- <TextBlock Text="{Binding Path=Name}" MouseLeftButtonDown="TargetItemClicked" Tag="{Binding}" Background="{Binding BackgroundColor}"/> -->
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
        
        <StatusBar Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="3">
            <StatusBarItem>
                <TextBlock Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Name="StatusProgress" Width="300" Height="25"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>