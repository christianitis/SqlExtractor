<Window x:Class="SqlExtractor.OutputToFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SqlExtractor"
        mc:Ignorable="d"
        Title="Output to Folder" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" Margin="100,20, 0,5">Folder:</TextBlock>
        <TextBox Grid.Column="1" Grid.Row="0" Name="FileTextBox" Margin="5, 20, 0 5" IsReadOnly="True"></TextBox>
        <Button Grid.Column="2" Grid.Row="0" Click="BrowseButton_OnClick" Padding="15,0" Margin="0,20,100,5">Browse...</Button>

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="0,20,0,1">Save files as...</TextBlock>
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <RadioButton Margin="10"
                         Tag="{x:Static local:OutputToFolderWindow+OutputType.OneFilePerObject}"
                         ToolTip="One .sql file is created per object."
                         Click="OutputRadioButton_OnClick"
                         CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}">
                One file per object
            </RadioButton>
            <RadioButton Margin="10"
                         Tag="{x:Static local:OutputToFolderWindow+OutputType.OneFilePerType}"
                         ToolTip="Creates a .sql file per object type. Example: StoredProcedures.sql, Tables.sql, etc..."
                         Click="OutputRadioButton_OnClick"
                         CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}">
                One file per object type
            </RadioButton>
            <RadioButton Margin="10"
                         Tag="{x:Static local:OutputToFolderWindow+OutputType.OneFile}"
                         ToolTip="A single .sql file is created, containing all objects in the Output Tree."
                         Click="OutputRadioButton_OnClick"
                         CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}">
                One file
            </RadioButton>
        </StackPanel>
        <Button Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Name="ExportButton"
                IsEnabled="False"
                Margin="150, 10" 
                Padding="10"
                Click="ExportButton_OnClick">
            Export
        </Button>
        <ProgressBar Grid.Row="4" 
                     Grid.Column="0" 
                     Grid.ColumnSpan="3" 
                     Height="20" 
                     Margin="150,10"
                     Name="StatusProgress"/>
        <TextBlock Grid.Row="5" 
                   Grid.Column="0" 
                   Grid.ColumnSpan="3"
                   TextAlignment="Center"
                   Margin="0,5,0,20"
                   Name="StatusText"/>
    </Grid>
</Window>